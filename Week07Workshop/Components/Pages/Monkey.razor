@page "/monkeys"

<h2>Monkey Directory</h2>
<p style="color: gray;">Displaying @monkeys.Count monkeys</p>

@if (monkeys.Count == 0)
{
    <p><em>No monkeys found</em></p>
}
else
{
    <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
        @foreach (var monkey in monkeys)
        {
            <div style="border: 1px solid #ddd; border-radius: 12px; padding: 15px; width: 280px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                <img src="@monkey.Image" alt="@monkey.Name" style="width: 100%; border-radius: 8px; height: 180px; object-fit: cover;" />
                <h3 style="margin-top: 10px;">@monkey.Name</h3>
                <p><strong>📍 Location:</strong> @monkey.Location</p>
                <p><strong>📊 Population:</strong> @monkey.Population.ToString("N0")</p>
                <p><strong>🌍 Coordinates:</strong> @monkey.Latitude, @monkey.Longitude</p>
                <p style="font-size: 0.9em; color: #555; margin-top: 10px;">@monkey.Details</p>
            </div>
        }
    </div>
}

