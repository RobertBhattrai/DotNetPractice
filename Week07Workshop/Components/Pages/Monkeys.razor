@page "/monkeys"

<h2>Monkey List</h2>

@if (monkeys.Count == 0)
{
    <p>No monkeys found</p>
}
else
{
    <div style="display:flex; flex-wrap:wrap; gap:20px;">
        @foreach (var monkey in monkeys)
        {
            <div style="
                width:280px;
                border:1px solid #ccc;
                border-radius:12px;
                padding:12px;
                box-shadow:0 0 5px rgba(0,0,0,0.2);
                    ">
                <img src="@monkey.Image" alt="@monkey.Name" width="260" style="border-radius:10px;" />

                <h3>@monkey.Name</h3>
                <p><strong>Location:</strong> @monkey.Location</p>
                <p><strong>Population:</strong> @monkey.Population</p>

                <p style="font-size:14px; margin-top:5px;">
                    @monkey.Details
                </p>

                <p style="font-size:13px; margin-top:8px;">
                    📍 <strong>Lat:</strong> @monkey.Latitude
                    <br />
                    📍 <strong>Lng:</strong> @monkey.Longitude
                </p>
            </div>
        }
    </div>
}

